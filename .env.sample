# .env — development template. Do not commit populated secrets.
# PYTHON_ENV=dev enables hot reload; use prod to disable it.
PYTHON_ENV=dev
ENABLE_HOT_RELOAD=true
# Development only: false disables certificate verification for IXPM peer refresh.
IXPM_VERIFY_SSL=true

# Canonical Discord/API settings. Legacy aliases DISCORD_TOKEN and DISCORD_GUILD
# remain accepted for existing development environments.
TOKEN={DISCORD-BOT-TOKEN-HERE}
GUILD_ID={DISCORD-BOT-SERVER-UID}
IXPM_API_KEY={IXPM-API-KEY}
IXPM_PEER_INFO=https://ixp-dev.edgeix.net.au/api/v4/member-export/ixf/1.0

RULES_CHANNEL_ID={RULES-CHANNEL-ID}
RULES_ACCEPTED_ROLE={RULES-ACCEPTED-ROLE-ID}
WELCOME_CHANNEL_ID={WELCOME-CHANNEL-ID}
ROLE_APPROVAL_CHANNEL_ID={ROLE-APPROVAL-CHANNEL-ID}
ANNOUNCEMENT_CHANNEL_ID={ANNOUNCEMENT-CHANNEL-ID}
PEER_ROLE={PEER-ROLE-ID}

SYD_RS1={SYDNEY_RS1}
SYD_RS2={SYDNEY_RS2}
MEL_RS1={MELBOURNE_RS1}
MEL_RS2={MELBOURNE_RS2}
ADL_RS1={ADELAIDE_RS1}
ADL_RS2={ADELAIDE_RS2}
BNE_RS1={BRISBANE_RS1}
BNE_RS2={BRISBANE_RS2}
PER_RS1={PERTH_RS1}
PER_RS2={PERTH_RS2}
DRW_RS1={DARWIN_RS1}
HBA_RS1={HOBART_RS1}

# Accepted aliases for older local files.
DISCORD_TOKEN={DISCORD-BOT-TOKEN-HERE}
DISCORD_GUILD={DISCORD-BOT-SERVER-UID}
